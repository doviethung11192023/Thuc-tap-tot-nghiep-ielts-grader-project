# ── Langfuse (SDK v4) ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# Keys are found at: cloud.langfuse.com → Settings → API Keys

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: process-level environment tag (shown in Langfuse UI)
# LANGFUSE_TRACING_ENVIRONMENT=production

# Optional: release / version tag
# LANGFUSE_RELEASE=v1.0.0

# ── OpenAI (required for LLM-as-judge evaluation) ─────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Generative AI (optional) ───────────────────────────────────────────
# GOOGLE_API_KEY=...

# ── ngrok tunnel ───────────────────────────────────────────────────────────────
# Lấy tại https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_authtoken_here
