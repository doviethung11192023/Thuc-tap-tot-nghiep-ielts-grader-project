# Copy to .env and fill in. Variable names are case-insensitive (settings/config.py).

# ── Langfuse (prompts are fetched with label "production") ─────────────────────
# Keys: cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CACHE_TTL_SECONDS=60

# ── LLM (any OpenAI-compatible endpoint; DashScope/Qwen by default) ────────────
QWEN_API_KEY=sk-...
# DEFAULT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DEFAULT_LLM_MODEL=qwen-flash            # 4 criterion agents + Task 2 classifier
# LLM_API_KEY=                            # key for DEFAULT_BASE_URL; empty → QWEN_API_KEY
# REWRITE_LLM_MODEL=                      # override the model in the Langfuse REWRITE config
# VISION_LLM_MODEL=qwen3.7-plus         # Task 1 chart reader (must accept image input)
# VISION_MAX_TOKENS=1500
# LLM_TIMEOUT_SECONDS=180
# LLM_ENABLE_THINKING=false               # DashScope Qwen3.x thinking mode (much slower)

# ── Writing Task 2 flow ────────────────────────────────────────────────────────
# WRITING_TASK2_PIPELINE=reference         # reference (needs data/reference_corpus) | legacy
# REFERENCE_CORPUS_DIR=                    # default: data/reference_corpus
# GRADE_LLM_MODEL=                         # override the model in the Langfuse grade config
# ESSAY_CLASSIFIER=jev                     # jev (needs TYPESAFE_API_KEY, falls back to Qwen) | qwen
# TYPESAFE_API_KEY=                        # empty → Qwen only. Only the task title is sent
# JEV_MODEL=jev-latest
# MAX_IMAGE_BYTES=8388608

# Example — switch every call to Gemini's OpenAI-compatible endpoint:
# DEFAULT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<gemini key>
# DEFAULT_LLM_MODEL=gemini-2.5-flash
# REWRITE_LLM_MODEL=gemini-2.5-flash
# VISION_LLM_MODEL=gemini-2.5-flash

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8001
# LOG_LEVEL=INFO
# SERVER_RELOAD=false

# ── ngrok tunnel (optional, off by default) ────────────────────────────────────
# ENABLE_NGROK=true
# NGROK_AUTH_TOKEN=your_ngrok_authtoken_here   # https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_STATIC_DOMAIN=your-name.ngrok-free.app

# ── Speaking ──
# Same value as AI_ENGINE_SECRET in the Core API .env. Empty disables the check (local only).
AI_ENGINE_SECRET=
# SPEECH_DEVICE=auto            # auto | cuda | cpu
# SPEECH_STT_MODEL=medium.en    # CPU-only VPS: small.en
# SPEECH_STT_COMPUTE_TYPE=auto  # CPU-only VPS: int8
