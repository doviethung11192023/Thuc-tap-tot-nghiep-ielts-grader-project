# Supabase Configuration (Required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis Configuration (Optional - Defaults to localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# AI Engine Service URL (Optional - Defaults to http://localhost:8001/grade)
AI_ENGINE_URL=http://localhost:8001/grade
AI_ENGINE_SPEAKING_URL=http://localhost:8001/grade-speaking
# Required: same value as AI_ENGINE_SECRET in the AI engine .env (engine returns 503 without it)
AI_ENGINE_SECRET=

# Fernet key that encrypts AI provider API keys saved in the app (spec 008). Without it, saving a key is refused (409).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_SECRETS_ENCRYPTION_KEY=

# Langfuse trace links on the admin pages (base URL and project id are not secrets)
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=

# Cloudflare R2 Storage (Optional - S3-compatible storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ielts-grader-media
R2_PUBLIC_DOMAIN=
# Bucket without public access for learner audio; needs CORS allowing PUT from the frontend origin
R2_PRIVATE_BUCKET_NAME=

# Postgres trực tiếp (Session pooler) cho migration/psql
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres


# Frontend base URL: links in invite / password-reset emails for Expert and Admin accounts.
# Production: the real frontend domain; it must also be in Supabase Auth -> URL Configuration -> Redirect URLs.
FRONTEND_URL=http://localhost:3000
# Frontend origins allowed to call the API (comma separated). Production: set the real frontend domain only.
CORS_ORIGINS=http://localhost:3000
# false on a public deployment to hide /docs, /redoc and /openapi.json
ENABLE_API_DOCS=true
