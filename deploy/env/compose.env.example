# Sao chép thành /srv/ielts/compose.env (chmod 600). Không commit bản thật.
# GHCR_OWNER: owner GitHub, viết thường. IMAGE_TAG do deploy.sh ghi đè mỗi lần deploy.
GHCR_OWNER=doviethung11192023
IMAGE_TAG=latest
# Mật khẩu Redis: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change-me-redis-password
# Token của Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels)
TUNNEL_TOKEN=change-me-tunnel-token
# Thư mục chứa backend.env, ai-engine.env, reference_corpus/
ENV_DIR=/srv/ielts
# Số tiến trình / hàng song song
WEB_CONCURRENCY=2
WRITING_CONCURRENCY=4
SPEAKING_CONCURRENCY=1
