# Sao chép thành /srv/ielts/backend.env (chmod 600). Giải thích từng biến: docs/deployment-guide.md §1.
# REDIS_URL, AI_ENGINE_URL, AI_ENGINE_SPEAKING_URL, WEB_CONCURRENCY do compose.prod.yml đặt: không khai ở đây.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
AI_ENGINE_SECRET=<secret-moi-giong-ai-engine.env>
AI_SECRETS_ENCRYPTION_KEY=<fernet-key-rieng-cho-production>
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
ENABLE_API_DOCS=false
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
R2_PRIVATE_BUCKET_NAME=
